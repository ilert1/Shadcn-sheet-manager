{
  "name": "react-sheet-manager",
  "version": "1.0.0",
  "description": "Type-safe sheet/modal management library for React with shadcn/ui",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "eslint src --ext .ts,.tsx",
    "test": "jest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "react",
    "sheet",
    "modal",
    "dialog",
    "shadcn",
    "typescript",
    "state-management"
  ],
  "author": "David Grigoryan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ilert1/ilert1/Shadcn-sheet-manager"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "typescript": "^5.0.0",
    "tsup": "^8.0.0",
    "@testing-library/react": "^14.0.0",
    "jest": "^29.0.0"
  }
}
